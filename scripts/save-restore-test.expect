#!/usr/bin/env expect
# save-restore test for gokvm using kernel_cpu (Linux 6.0, NR_CPUS=1)
# Phase 1: boot, verify echo booted, save state via ^A^Z (exits automatically)
# Phase 2: resume from state, verify echo booted again

set timeout 60
set statefile "/tmp/gokvm_test.state"
set kernel    "./kernel_cpu"
set initrd    "./initrd"

file delete -force $statefile

puts "=== Phase 1: boot and save ==="
spawn ./gokvm boot -c 1 -k $kernel -i $initrd -S $statefile
expect {
    "Setting console log level" {}
    timeout { puts "FAIL: phase 1 boot timeout"; exit 1 }
}
sleep 3
send "echo booted\r"
expect {
    "booted" { puts "PASS: phase 1 echo booted" }
    timeout  { puts "FAIL: phase 1 echo booted timeout"; exit 1 }
}

# Trigger save via ^A then ^Z — serial.Start saves synchronously then exits.
send "\x01"
sleep 0.2
send "\x1a"

# Wait for the process to exit (save runs synchronously before exit).
set timeout 120
expect {
    eof     { puts "PASS: phase 1 exited after save" }
    timeout { puts "FAIL: phase 1 did not exit after save"; exit 1 }
}

if {![file exists $statefile] || [file size $statefile] == 0} {
    puts "FAIL: state file missing or empty"
    exit 1
}
puts "PASS: state file saved ([file size $statefile] bytes)"

puts "=== Phase 2: resume and verify ==="
set timeout 60
spawn ./gokvm boot -c 1 -k $kernel -i $initrd -R $statefile
expect {
    "Setting console log level" {}
    "Resumed from"             {}
    timeout { puts "FAIL: phase 2 resume timeout"; exit 1 }
}
sleep 3
send "echo booted\r"
expect {
    "booted" { puts "PASS: phase 2 echo booted after resume"; exit 0 }
    timeout  { puts "FAIL: phase 2 echo booted timeout"; exit 1 }
}
